# Ignore build outputs
/build/
/out/
/target/
/bin/
/dist/
/lib/
/*.class
*.class
*.log
hs_err_pid*
replay_pid*

# Ignore Java artifacts
*.jar
*.war
*.ear
*.nar
*.zip
*.tar

# Ignore IDE files
/.idea/
*.iml
*.ipr
*.iws
/.project
/.classpath
.vscode/

# macOS / Windows
.DS_Store
Thumbs.db

# CMake and C/C++ build artifacts
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.o
*.obj
*.lo
*.la
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
build-*/

# Native image / GraalVM outputs
/native-image/
*.native
/*-script.dll
*.so
*.dylib

# ASI / game artifacts (built loaders)
*.asi

# Temporary and editor files
*~
*.swp
*.swo

# Logs and runtime files
logs/
*.log

# Deployment/runtime directories that should not be committed
RageModHotSpot/jre-minimal/
RageModHotSpot/mods/*.jar
RageModGraalVM/*.dll

# Environment files
.env
.env.local

# Node/npm (if used accidentally)
node_modules/
npm-debug.log

# Coverage reports
coverage/

# Generated by OS or tools
.idea/
.vscode/

# Keep README, LICENSE and source files tracked
!README.md
!LICENSE
!**/*.java
